# Public template: keep credential values blank. Put real values only in your local .env.
# ---------- Splunk Observability API ----------
SFX_TOKEN=
SFX_REALM=us1
SFX_TIMEOUT_SECONDS=30
SFX_MAX_RETRIES=3
SFX_BACKOFF_FACTOR=0.5
SFX_POOL_MAXSIZE=10
# SFX_CA_BUNDLE=/path/to/corporate-ca.pem
# SFX_API_BASE_URL=https://api.us1.signalfx.com
# SFX_STREAM_BASE_URL=https://stream.us1.signalfx.com

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---------- Webhook receiver ----------
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhooks/splunk
WEBHOOK_WORKERS=1
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SHARED_SECRET=
WEBHOOK_REQUIRE_SIGNATURE=true
WEBHOOK_MAX_BODY_BYTES=262144
# WEBHOOK_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16
WEBHOOK_TRUST_PROXY_HEADERS=false
WEBHOOK_FORWARDED_ALLOW_IPS=127.0.0.1
WEBHOOK_DEDUPE_TTL_SECONDS=300
WEBHOOK_CONSOLE_OUTPUT=true
# WEBHOOK_OUTPUT_FILE=./data/alerts.jsonl
# WEBHOOK_SSL_CERTFILE=/path/to/cert.pem
# WEBHOOK_SSL_KEYFILE=/path/to/key.pem
